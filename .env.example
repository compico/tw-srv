# Публичный домен (без схемы). Traefik роутит /auth/* в twitch-auth, остальное в memealerts.
DOMAIN=memes.example.com

# https://dev.twitch.tv/console/apps
# OAuth Redirect URL: https://<DOMAIN>/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Регистрируется через поддержку MemeAlerts (API в режиме тестирования).
# Redirect URI: https://<DOMAIN>/api/memealerts/callback
# Scopes: oauth-user-show oauth-bonus-give
MEMEALERTS_CLIENT_ID=
MEMEALERTS_CLIENT_SECRET=

# Ключи шифрования токенов в SQLite: openssl rand -hex 32. Для сервисов разные.
AUTH_ENCRYPTION_KEY=
MEMEALERTS_ENCRYPTION_KEY=

# Секрет для gRPC между сервисами: openssl rand -hex 32
GRPC_SHARED_SECRET=

# Twitch user id администратора поддержки (виден в логах memealerts как user=...).
# Пусто: просматривать все заявки не сможет никто.
ADMIN_TWITCH_ID=

# Необязательно: дополнительные источники для CORS через запятую (адрес сайта разрешён всегда),
# например http://localhost:8080 при локальной разработке.
# CORS_ALLOWED_ORIGINS=

# Traefik. Значения по умолчанию подходят вашей инсталляции; менять нужно, только если они отличаются.
# TRAEFIK_NETWORK=proxy
# TRAEFIK_ENTRYPOINT_HTTP=web
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=cloudflare
# TRAEFIK_MIDDLEWARES=default-headers@file
# TRAEFIK_REDIRECT_MIDDLEWARE=https-redirect@file
