# Домены (без схемы). У каждого сервиса свой.
# AUTH_DOMAIN: вход через Twitch (twitch-auth), APP_DOMAIN: панель стримера и API (memealerts).
AUTH_DOMAIN=tw.example.com
APP_DOMAIN=memealerts.example.com
# Общий родительский домен обоих: cookie сессии ставится на него, чтобы её видели оба сервиса.
COOKIE_DOMAIN=example.com

# https://dev.twitch.tv/console/apps
# OAuth Redirect URL: https://<AUTH_DOMAIN>/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Регистрируется через поддержку MemeAlerts (API в режиме тестирования).
# Redirect URI: https://<APP_DOMAIN>/api/memealerts/callback
# Scopes: oauth-user-show oauth-bonus-give
MEMEALERTS_CLIENT_ID=
MEMEALERTS_CLIENT_SECRET=

# Ключи шифрования токенов в SQLite: openssl rand -hex 32. Для сервисов разные.
AUTH_ENCRYPTION_KEY=
MEMEALERTS_ENCRYPTION_KEY=

# Секрет для gRPC между сервисами: openssl rand -hex 32
GRPC_SHARED_SECRET=

# Traefik (необязательно). Значения ниже действуют по умолчанию; раскомментируйте и измените, если у вас другие имена.
# TRAEFIK_NETWORK=proxy
# TRAEFIK_ENTRYPOINT_HTTP=web
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=cloudflare
# TRAEFIK_MIDDLEWARES=default-headers@file
# TRAEFIK_REDIRECT_MIDDLEWARE=https-redirect@file
